# App
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=
COOKIE_SECURE=false

# SQLite by default. For Postgres (Render/Railway):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/calai

# Google OAuth + Calendar (never commit real secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# AI (Gemini free tier recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
